### get token from test application
POST http://localhost:8082/api/v1/test/sign
Content-Type: application/json

{
  "sub": "fcad941c-aea5-426f-8f17-428add82aeb1",
  "resource_access": {
    "account": {
      "roles": [
        "manage-account",
        "manage-account-links",
        "view-profile"
      ]
    }
  },
  "email_verified": "false",
  "allowed-origins": [
    "/*"
  ],
  "iss": "http://auth.gateway.com:9999/realms/cvhome",
  "typ": "Bearer",
  "preferred_username": "microservice-gateway",
  "given_name": "",
  "sid": "ea59acba-c673-42f5-a374-5e0a30802683",
  "aud": "account",
  "realm_access": {
    "roles": [
      "ADMIN",
      "ROLE_MICROSERVICE",
      "offline_access",
      "uma_authorization",
      "default-roles-cvhome",
      "ROLE_MICROSERVICE_GATEWAY"
    ]
  },
  "azp": "microservice-app",
  "scope": "profile email",
  "session_state": "ea59acba-c673-42f5-a374-5e0a30802683",
  "family_name": "",
  "jti": "84a4b2a4-b463-4df4-9640-c669124402d3"
}

> {%
    client.global.set("access_token", response.body.access_token)
%}



### get token for microservice-domain-certificate-manager
POST http://auth.gateway.com:9999/realms/cvhome/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id = microservice-app &
client_secret = r1nuVn4HefusLGwHIeRxbdOzdTZLEMvQ &
grant_type = password &
username = microservice-gateway
    &
password = microservice-gateway

> {%
    client.global.set("access_token", response.body.access_token)
%}


### get proving
POST http://localhost:8082/api/v1/domain-ownership/get-proving
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "domain": "aswwa.asrevo.com"
}


### register a domain
POST http://localhost:8082/api/v1/domain-ownership/register
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "domain": {
    "domain": "*.asrevo.com"
  },
  "domainType": "SAS_SUB"
}

### change reference
POST http://localhost:8081/api/v1/domain-ownership/change-reference
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "domain": {
    "domain": "test1.asrevo.com"
  },
  "reference": {
    "reference": "nnnnnnnnnnnn",
    "referenceType": "BLOG"
  }
}
