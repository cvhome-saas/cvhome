{
  "lcl": {
    "ORG_ADMIN_SESSION_ID": "paste-a-fresh-session-id-here",
    "SUPER_ADMIN_SESSION_ID": "paste-a-fresh-session-id-here",
    "SHOPPER_TOKEN": "paste-a-shopper-access-token-here (landing-ui sessionStorage auth-tokens)",
    "S2S_TOKEN": "paste-a-client_credentials-token-of-the-pod-s2s-client-here",
    "SUBJECT_TOKEN": "paste-an-operator-access-token-here (uaa/http/impersonation-api.http says where)",
    "IMPERSONATION_SECRET": "the console-impersonation client secret (UAA_IMPERSONATION_SECRET; lcl: see uaa's application-lcl.yml)",
    "WEB_APP_SECRET": "the web-app client secret (UAA_WEB_APP_SECRET)"
  }
}
