{
  "name": "@cvhome-saas/ui-kit",
  "version": "0.0.1",
  "description": "The console design system and application infrastructure, shared by console-ui and uaa-fe.",
  "sideEffects": false,
  "exports": {
    "./theme/css/*": {
      "default": "./theme/css/*"
    },
    "./ui/styles/*": {
      "default": "./ui/styles/*"
    }
  },
  "scripts": {
    "build": "ng build ui-kit",
    "watch": "ng build ui-kit --watch --configuration development",
    "test": "ng test ui-kit",
    "test:ci": "ng test ui-kit --watch=false --browsers=ChromeHeadless",
    "lint": "eslint . && npm run lint:css",
    "lint:css": "stylelint \"{src,ui,forms,theme}/**/*.css\" --quiet",
    "lint:css:debt": "stylelint \"{src,ui,forms,theme}/**/*.css\"",
    "ng": "ng"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "peerDependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-locale": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "rxjs": "~7.8.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.28",
    "@angular/cdk": "^20.2.14",
    "@angular/cli": "^20.3.28",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@eslint/js": "^9.39.5",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-locale": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0",
    "zone.js": "~0.15.0"
  }
}
