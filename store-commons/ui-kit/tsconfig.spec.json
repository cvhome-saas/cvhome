{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine"
    ]
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "ui/**/*.spec.ts",
    "theme/**/*.spec.ts",
    "i18n/**/*.spec.ts",
    "forms/**/*.spec.ts",
    "uaa/**/*.spec.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out-tsc"
  ]
}
