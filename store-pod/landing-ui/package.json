{
  "name": "store-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "libs/*",
    "templates/*"
  ],
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "node src/server.ts",
    "build": "tsc -b && npm run build:libs-types && npm run build:libs-services && npm run build:templates",
    "build:libs-types": "npm run build --workspace=libs/types",
    "build:libs-services": "npm run build --workspace=libs/services",
    "build:templates": "npm run build --workspace=templates",
    "build:prod": "npm run build && npm prune --production",
    "test": "npm run test --workspaces"
  },
  "dependencies": {
    "express": "^4.19.2",
    "next": "16.0.0",
    "next-intl": "^4.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}
