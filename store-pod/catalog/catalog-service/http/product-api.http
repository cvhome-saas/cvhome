# ProductApiV2 + ProductApi + ExternalProductApi — com.asrevo.cvhome.catalog.api
#
# Addressed through the gateway, not catalog's own port: a seller request crosses store-core-gateway (:8000)
# then the pod's spg, so `{{SELLER_UI_URL}}/spg/catalog/...` is what production traffic looks like. Env vars
# come from the repo-root http-client.env.json; the session id from http-client.private.env.json (gitignored).
#
# Requires a running stack: lcl start -d

### create a product (v2 definition) — 201 {"id": n}
# @name createProduct
POST {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{
  "sku": "HTTP-DEMO-001",
  "visible": true,
  "shipeable": true,
  "productSpecifications": {"weight": 1, "height": 1, "width": 1, "length": 1},
  "descriptions": [
    {"language": "en", "name": "Demo product", "description": "Created from product-api.http", "friendlyUrl": "demo-product"}
  ]
}

> {%
    client.test("created", function () {
        client.assert(response.status === 201, "status " + response.status);
        client.global.set("PRODUCT_ID", response.body.id);
    });
%}

### invalid body — 400 (sku is required)
POST {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{"descriptions": []}

### unknown brand code — 400 CATALOG.MANUFACTURER.REFERENCE_UNRESOLVABLE
POST {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{"sku": "HTTP-DEMO-002", "manufacturer": "no-such-brand", "descriptions": [{"language": "en", "name": "x"}]}

### the definition, every language
GET {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product/{{PRODUCT_ID}}?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### update the definition — 200, no body
PUT {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product/{{PRODUCT_ID}}?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{
  "sku": "HTTP-DEMO-001",
  "visible": true,
  "categories": [{"id": 1}],
  "descriptions": [{"language": "en", "name": "Demo product, renamed", "friendlyUrl": "demo-product"}]
}

### is the sku taken — {"exists": true}
GET {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/unique?store={{STORE_ID}}&lang={{LANG}}&code=HTTP-DEMO-001
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### inline edit: the two switches
PATCH {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/{{PRODUCT_ID}}?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{"available": false, "productShipeable": true}

### category membership — 201, then 409 CATALOG.CATEGORY.ALREADY_ATTACHED on repeat
POST {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/{{PRODUCT_ID}}/category/2?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

###
DELETE {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/{{PRODUCT_ID}}/category/2?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### the listing (public; the console reads the same one) — filters: sku, available, categoryIds, manufacturerId
GET {{LANDING_UI_URL}}/catalog/api/v2/products?store={{STORE_ID}}&lang={{LANG}}&sku=NK&count=5&page=0

### the product page, by slug — 404 CATALOG.PRODUCT.NOT_FOUND for an unknown slug
GET {{LANDING_UI_URL}}/catalog/api/v2/product/name/demo-product?store={{STORE_ID}}&lang={{LANG}}

### checkout's s2s read, by sku (public read, no price — inventory has that)
GET {{LANDING_UI_URL}}/catalog/api/v1/detailed-product?store={{STORE_ID}}&lang={{LANG}}&sku=HTTP-DEMO-001

### delete the product (and its image files)
DELETE {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/{{PRODUCT_ID}}?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### private write without a session — 401
PATCH {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/1?store={{STORE_ID}}&lang={{LANG}}
Content-Type: application/json

{"available": true, "productShipeable": true}
