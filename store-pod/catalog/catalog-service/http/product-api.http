# ProductApiV2 + ProductApi + ExternalProductApi — com.asrevo.cvhome.catalog.api
#
# Addressed through the gateway, not catalog's own port: a seller request crosses store-core-gateway (:8000)
# then the pod's spg, so `{{SELLER_UI_URL}}/spg/catalog/...` is what production traffic looks like. Env vars
# come from the repo-root http-client.env.json; the session id from http-client.private.env.json (gitignored).
#
# Requires a running stack: lcl start -d

### create a product (v2 definition) — 201 {"id": n}
# @name createProduct
POST {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{
  "sku": "HTTP-DEMO-001",
  "visible": true,
  "shipeable": true,
  "productSpecifications": {"weight": 1, "height": 1, "width": 1, "length": 1},
  "descriptions": [
    {"language": "en", "name": "Demo product", "description": "Created from product-api.http", "friendlyUrl": "demo-product"}
  ]
}

> {%
    client.test("created", function () {
        client.assert(response.status === 201, "status " + response.status);
        client.global.set("PRODUCT_ID", response.body.id);
    });
%}

### invalid body — 400 (sku is required)
POST {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{"descriptions": []}

### unknown brand code — 400 CATALOG.MANUFACTURER.REFERENCE_UNRESOLVABLE
POST {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{"sku": "HTTP-DEMO-002", "manufacturer": "no-such-brand", "descriptions": [{"language": "en", "name": "x"}]}

### the definition, every language
GET {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product/{{PRODUCT_ID}}?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### update the definition — 200, no body
PUT {{SELLER_UI_URL}}/spg/catalog/api/v2/private/product/{{PRODUCT_ID}}?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{
  "sku": "HTTP-DEMO-001",
  "visible": true,
  "categories": [{"id": 1}],
  "descriptions": [{"language": "en", "name": "Demo product, renamed", "friendlyUrl": "demo-product"}]
}

### is the sku taken — {"exists": true}
GET {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/unique?store={{STORE_ID}}&lang={{LANG}}&code=HTTP-DEMO-001
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### inline edit: the two switches
PATCH {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/{{PRODUCT_ID}}?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{"available": false, "productShipeable": true}

### category membership — 201, then 409 CATALOG.CATEGORY.ALREADY_ATTACHED on repeat
POST {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/{{PRODUCT_ID}}/category/2?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

###
DELETE {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/{{PRODUCT_ID}}/category/2?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### the listing (public; the console reads the same one) — filters: sku, available, categoryIds, manufacturerId
GET {{LANDING_UI_URL}}/catalog/api/v2/products?store={{STORE_ID}}&lang={{LANG}}&sku=NK&count=5&page=0

### full-text search — relevance-ordered, with the counted filter rail
GET {{LANDING_UI_URL}}/catalog/api/v2/products/search?store={{STORE_ID}}&lang={{LANG}}&q=nike&facets=true&count=5&page=0

> {%
    client.test("relevant and counted", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.totalElements > 0, "no results for a seeded brand");
        client.assert(response.body.facets.brands.length > 0, "no brand buckets");
    });
%}

### the same term in Arabic — the merchant's own copy, not a transliteration
GET {{LANDING_UI_URL}}/catalog/api/v2/products/search?store={{STORE_ID}}&lang=ar&q=نايكي&count=5

### a typo — results for the correction, and `didYouMean` naming it
GET {{LANDING_UI_URL}}/catalog/api/v2/products/search?store={{STORE_ID}}&lang={{LANG}}&q=runing&count=5

> {%
    client.test("corrected", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.didYouMean, "no didYouMean for a typo");
    });
%}

### a term the shop does not carry — an empty page and no correction invented for it
GET {{LANDING_UI_URL}}/catalog/api/v2/products/search?store={{STORE_ID}}&lang={{LANG}}&q=lego&count=5

> {%
    client.test("no false correction", function () {
        client.assert(response.body.totalElements === 0, "unexpected results");
        client.assert(!response.body.didYouMean, "corrected an absent term into " + response.body.didYouMean);
    });
%}

### a blank term degrades to a filtered listing — what the results page needs when the term is cleared
GET {{LANDING_UI_URL}}/catalog/api/v2/products/search?store={{STORE_ID}}&lang={{LANG}}&q=&sort=NEWEST&facets=false&count=5

### autocomplete — capped at 10 however large `limit` is, cacheable for 30s
GET {{LANDING_UI_URL}}/catalog/api/v2/products/suggest?store={{STORE_ID}}&lang={{LANG}}&q=invinc&limit=8

> {%
    client.test("suggested", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.length <= 10, "over the cap");
    });
%}

### tenant isolation: store1's sku, asked of store2 — 0 results, never a leak
GET {{LANDING_UI_URL}}/catalog/api/v2/products/search?store={{STORE_ID_2}}&lang={{LANG}}&q=SKU-NK-RUN-001&count=5

### rebuild the store's search index — 202, no body (for after the document's shape changes)
POST {{SELLER_UI_URL}}/spg/catalog/api/v2/private/products/search-index/rebuild?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### rebuild without a session — 401
POST {{SELLER_UI_URL}}/spg/catalog/api/v2/private/products/search-index/rebuild?store={{STORE_ID}}&lang={{LANG}}

### the product page, by slug — 404 CATALOG.PRODUCT.NOT_FOUND for an unknown slug
GET {{LANDING_UI_URL}}/catalog/api/v2/product/name/demo-product?store={{STORE_ID}}&lang={{LANG}}

### checkout's s2s read, by sku (public read, no price — inventory has that)
GET {{LANDING_UI_URL}}/catalog/api/v1/detailed-product?store={{STORE_ID}}&lang={{LANG}}&sku=HTTP-DEMO-001

### delete the product (and its image files)
DELETE {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/{{PRODUCT_ID}}?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### private write without a session — 401
PATCH {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/1?store={{STORE_ID}}&lang={{LANG}}
Content-Type: application/json

{"available": true, "productShipeable": true}

### the s2s bulk read: one call for a whole cart's skus (missing skus are simply absent)
GET {{LANDING_UI_URL}}/catalog/api/v1/detailed-products?store={{STORE_ID}}&lang={{LANG}}&skus=SKU-NK-RUN-001,SKU-ZR-CL-DRS02-BL-M,NO-SUCH-SKU

### a combination sku resolves to its parent product, with the option/value label block
GET {{LANDING_UI_URL}}/catalog/api/v1/detailed-product?store={{STORE_ID}}&lang={{LANG}}&sku=SKU-ZR-CL-DRS02-BL-M

> {%
    client.test("carries the selection labels", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.variant.optionValues.length === 2, "labels missing");
    });
%}

### listing filtered by option values (OR within an option, AND across options, one variant matches both)
GET {{LANDING_UI_URL}}/catalog/api/v2/products?store={{STORE_ID}}&lang={{LANG}}&optionValueIds=2,3&page=0&count=24

### search with option facets in the rail
GET {{LANDING_UI_URL}}/catalog/api/v2/products/search?store={{STORE_ID}}&lang={{LANG}}&q=&optionValueIds=4&page=0&count=24
