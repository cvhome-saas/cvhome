# ProductImageApi — com.asrevo.cvhome.catalog.api.v1.ProductImageApi (@RequestMapping "/api/v1")
# See product-api.http for the env-var conventions. Requires a running stack: lcl start -d
#
# Catalog does not accept uploads any more. Put the bytes in the media library first —
# POST /spg/content/api/v1/private/content/media, see content-service/http/media-api.http — and attach the
# asset ids it returns. That is what gives a product photo alt text, dimensions, reuse across products, and
# protection from being deleted out from under a live listing.

### attach library assets to product 1 — 201; the first image of an empty gallery becomes its default
POST {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/1/images?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

[
  {"mediaAssetId": 1, "altText": "Front view"},
  {"mediaAssetId": 2, "altText": "Side view"}
]

### the product's images, in display order (public)
GET {{LANDING_UI_URL}}/catalog/api/v1/product/1/images?store={{STORE_ID}}&lang={{LANG}}

### replace the whole gallery — order is the list order, and the flagged item becomes the default.
### This is how the default image is changed; the old PATCH ?order= could only renumber.
PUT {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/1/images?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

[
  {"mediaAssetId": 2, "altText": "Side view", "defaultImage": true},
  {"mediaAssetId": 1, "altText": "Front view"}
]

### an external url or a video, which the library does not hold
PUT {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/1/images?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

[
  {"videoUrl": "https://www.youtube.com/watch?v=xyz"}
]

### an asset id that is not this store's — 400 CATALOG.PRODUCT_IMAGE.ASSET_UNKNOWN, nothing written
POST {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/1/images?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

[{"mediaAssetId": 999999}]

### detach an image — 204. The asset stays in the library; other products may still show it.
DELETE {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/1/image/1?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}

### unknown product — 404 CATALOG.PRODUCT.NOT_FOUND
GET {{LANDING_UI_URL}}/catalog/api/v1/product/999999/images?store={{STORE_ID}}&lang={{LANG}}

### tenant isolation — another store cannot attach to this product
POST {{SELLER_UI_URL}}/spg/catalog/api/v1/private/product/1/images?store={{OTHER_STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

[{"mediaAssetId": 1}]
