# ProductInventoryApi — com.asrevo.cvhome.inventory.api.v1.ProductInventoryApi (@RequestMapping "/api/v1")
#
# Addressed through the gateway, not inventory's own port: a seller request really crosses
# store-core-gateway (:8000) then the pod's spg, so `{{SELLER_UI_URL}}/spg/inventory/...` is what
# production traffic looks like. Env vars come from the repo-root http-client.env.json; the session
# id comes from http-client.private.env.json (gitignored — copy the .example and log in once).
#
# Requires a running stack: ./extra/scripts/run-lcl.sh

### upsert an inventory record by sku (the console's single-product write path)
# @name upsertInventory
PUT {{SELLER_UI_URL}}/spg/inventory/api/v1/private/inventory/SKU-YSL-MAKE-TEIPEN46?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{
  "productId": 46,
  "quantity": 12,
  "available": true,
  "prices": [
    {
      "code": "base",
      "defaultPrice": true,
      "price": 25.00
    }
  ]
}

> {%
    client.test("upserted", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
    client.global.set("INVENTORY_ID", response.body.id);
%}

### list inventory for a sku
GET {{SELLER_UI_URL}}/spg/inventory/api/v1/private/product/SKU-YSL-MAKE-TEIPEN46/inventory?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Accept: application/json

### list inventory by product id
GET {{SELLER_UI_URL}}/spg/inventory/api/v1/private/product/inventory?productId=46&store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Accept: application/json

### public bulk read — stock and price for a set of skus (storefront path, no auth)
GET {{LANDING_UI_URL}}/inventory/api/v1/availability?skus=SKU-YSL-MAKE-TEIPEN46,SKU-UNKNOWN&store={{STORE_ID}}&lang={{LANG}}
Accept: application/json

### tenant isolation — another store must not see this store's inventory (empty list)
GET {{SELLER_UI_URL}}/spg/inventory/api/v1/private/product/SKU-YSL-MAKE-TEIPEN46/inventory?store={{STORE_ID_2}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Accept: application/json

### no token — 401/403, not an empty 200
GET {{SELLER_UI_URL}}/spg/inventory/api/v1/private/product/SKU-YSL-MAKE-TEIPEN46/inventory?store={{STORE_ID}}&lang={{LANG}}
Accept: application/json

### delete inventory rows for a product (orphan cleanup after a catalog delete)
DELETE {{SELLER_UI_URL}}/spg/inventory/api/v1/private/inventory/by-product/46?store={{STORE_ID}}&lang={{LANG}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
