{
	debug
	admin 0.0.0.0:2019

	log {
		format json
		level ERROR
	}

	storage s3 {
		bucket              {$CERT_BUCKET}
		region              {$CERT_BUCKET_REGION}
		# Optional:
		# prefix              your/custom/prefix  # Default is "certmagic"
		# access_key_id       YOUR_AWS_ACCESS_KEY_ID
		# secret_access_key   YOUR_AWS_SECRET_ACCESS_KEY
		# endpoint            https://your-s3-compatible-endpoint.com
		# encryption_key      your-32-byte-long-encryption-key
	}

	on_demand_tls {
		ask {$ASK_TLS_URL}
	}
}

http:// {
	route {
		domain_lookup {
			lookup_url {$DOMAIN_LOOKUP_URL}
			cache_ttl  5m
		}

		reverse_proxy {$STORE_POD_GATEWAY}
	}
}

https:// {
	log
	tls {
		on_demand
	}

	route {
		domain_lookup {
			lookup_url {$DOMAIN_LOOKUP_URL}
		}

		reverse_proxy {$STORE_POD_GATEWAY}
	}
}
