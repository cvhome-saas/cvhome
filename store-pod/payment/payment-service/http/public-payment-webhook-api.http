# PublicPaymentWebhookApi — com.asrevo.cvhome.payment.api.v1.payment.PublicPaymentWebhookApi
#
# The provider telling payment what became of a checkout session. Public by necessity — Stripe holds no token of
# ours — so the store's own webhook secret is the credential: the store id is in the path, and the delivery is
# verified against that store's payment_configuration.webhook_secret before anything is scheduled. Addressed the way
# Stripe reaches it: through the pod edge (spg strips the /payment prefix), which is what lcl's
# stripe-org1-store1-webhook listener forwards to.
#
# A real delivery is easiest from the Stripe CLI: `stripe trigger checkout.session.completed` while the listener is
# up. The blocks below hand-sign a session-completed event with WEBHOOK_SECRET (the secret configured for the store;
# http-client.private.env.json). Only an authentic delivery is answered 200 and written to the outbox; a forged or
# unsigned one is 400 (PAYMENT.WEBHOOK.SIGNATURE_INVALID) and an unknown store or unconfigured type is 404
# (PAYMENT.CONFIGURATION.NOT_FOUND) — the same 404 whether the id is not a store or the store has nothing enabled,
# so the endpoint confirms nothing to a stranger. The outbox handler verifies again on its own before settling.
#
# Requires a running stack: lcl start -d

### a signed checkout.session.completed — 200 and one outbox row; the referenced transaction settles to PAID
# The signature is Stripe's scheme, t=<epoch>,v1=<hmac-sha256 hex of "<epoch>.<payload>">, over the exact body
# bytes; compute it for the body below with WEBHOOK_SECRET and paste the whole header value into STRIPE_SIGNATURE
# (a pre-request script cannot read the body). GATEWAY_REF is set by external-payment-gateway-api.http's initiate.
POST {{SPG_URL}}/payment/api/v1/public/webhook/{{STORE_ID}}/STRIPE
Content-Type: application/json
Stripe-Signature: {{STRIPE_SIGNATURE}}

{"id":"evt_http_1","object":"event","api_version":"2024-06-20","type":"checkout.session.completed","data":{"object":{"id":"cs_http_1","object":"checkout.session","client_reference_id":"{{GATEWAY_REF}}"}}}

### no signature header — 400 PAYMENT.WEBHOOK.SIGNATURE_INVALID with signaturePresent=false; no outbox row (WHK-05)
POST {{SPG_URL}}/payment/api/v1/public/webhook/{{STORE_ID}}/STRIPE
Content-Type: application/json

{"id":"evt_http_2","object":"event","api_version":"2024-06-20","type":"checkout.session.completed","data":{"object":{"id":"cs_http_2","object":"checkout.session","client_reference_id":"{{GATEWAY_REF}}"}}}

### a signature over a different body — 400 PAYMENT.WEBHOOK.SIGNATURE_INVALID with signaturePresent=true (WHK-01)
# Reuse the STRIPE_SIGNATURE computed for the first block: the id below differs, so the HMAC does not match.
POST {{SPG_URL}}/payment/api/v1/public/webhook/{{STORE_ID}}/STRIPE
Content-Type: application/json
Stripe-Signature: {{STRIPE_SIGNATURE}}

{"id":"evt_http_3","object":"event","api_version":"2024-06-20","type":"checkout.session.completed","data":{"object":{"id":"cs_http_1","object":"checkout.session","client_reference_id":"{{GATEWAY_REF}}"}}}

### a store id nobody owns — 404 PAYMENT.CONFIGURATION.NOT_FOUND, nothing looked up beyond the configuration
POST {{SPG_URL}}/payment/api/v1/public/webhook/000000000000000000000000/STRIPE
Content-Type: application/json
Stripe-Signature: {{STRIPE_SIGNATURE}}

{"id":"evt_http_1","object":"event","api_version":"2024-06-20","type":"checkout.session.completed","data":{"object":{"id":"cs_http_1","object":"checkout.session","client_reference_id":"{{GATEWAY_REF}}"}}}

### a store id that is not an ObjectId — the same 404, before any lookup
POST {{SPG_URL}}/payment/api/v1/public/webhook/not-a-store/STRIPE
Content-Type: application/json
Stripe-Signature: {{STRIPE_SIGNATURE}}

{"id":"evt_http_1","object":"event","api_version":"2024-06-20","type":"checkout.session.completed","data":{"object":{"id":"cs_http_1","object":"checkout.session","client_reference_id":"{{GATEWAY_REF}}"}}}

### a type the store has no enabled configuration or processor for — 404 PAYMENT.CONFIGURATION.NOT_FOUND (WHK-06)
POST {{SPG_URL}}/payment/api/v1/public/webhook/{{STORE_ID}}/PAYPAL
Content-Type: application/json

{"event":"nothing-handles-this"}
