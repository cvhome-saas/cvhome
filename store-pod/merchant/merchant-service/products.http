### create category
POST http://localhost:8089/api/v1/admin/category/create?store=65f023632bc46470c104b76f
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "name": "string",
  "imageLink": {
    "imageLink": "https://google.com"
  },
  "sequence": 0
}

### create single product
POST http://localhost:8089/api/v1/admin/products/create?store=65f023632bc46470c104b76f
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "dto": {
    "name": "string",
    "description": "string",
    "price": {
      "price": 20,
      "currency": "USD"
    },
    "imageLink": {
      "imageLink": "https://google.com"
    },
    "amount": {
      "amount": 15
    },
    "productType": "SINGLE",
    "imageLinks": {
      "imagesLinks": [
        {
          "imageLink": "https://google.com"
        }
      ]
    },
    "category": {
      "id": {
        "id": "65f5b471c919a450ab3f8649"
      }
    }
  }
}


### get product details
GET http://localhost:8089/api/v1/admin/products/detailed-product?store=65f023632bc46470c104b76f&
    productId=65f5a789e37ac17bfb45926f
Accept: application/json
Authorization: Bearer {{access_token}}



### find all
POST http://localhost:8089/api/v1/admin/products/find-all?store=65f023632bc46470c104b76f
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
}

### find all in  category
POST http://localhost:8089/api/v1/admin/products/find-all?store=65f023632bc46470c104b76f
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "category": {
    "id": {
      "id": "65f5afd81807e746f740e320"
    }
  }
}





### create group product
POST http://localhost:8089/api/v1/admin/products/create?store=65f023632bc46470c104b76f
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "dto": {
    "name": "string",
    "description": "string",
    "price": {
      "price": 20,
      "currency": "USD"
    },
    "imageLink": {
      "imageLink": "https://google.com"
    },
    "amount": {
      "amount": 15
    },
    "productType": "GROUP",
    "imageLinks": {
      "imagesLinks": [
        {
          "imageLink": "https://google.com"
        }
      ]
    },
    "category": {
      "id": {
        "id": "65f5b471c919a450ab3f8649"
      }
    }
  },
  "productDetails": {
    "detail": {
      "name": "any",
      "descriptions": [
        "d1",
        "d2"
      ],
      "ltr": false,
      "shortDescription": "sd",
      "spec": {
        "key": "value"
      }
    },
    "extraImages": {
      "imagesLinks": [
        {
          "imageLink": "https://google.com"
        }
      ]
    }
  },
  "subProducts": [
    {
      "id": {
        "id": {
          "id": "65f5b494c919a450ab3f864b"
        }
      }
    },
    {
      "id": {
        "id": {
          "id": "65f5b484c919a450ab3f864a"
        }
      }
    }
  ]
}

