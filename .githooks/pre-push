#!/usr/bin/env bash
#
# A push is allowed only for a tree that `extra/scripts/verify-before-push.sh` has passed in full.
#
# The script writes `<git-dir>/cvhome-verified` with a digest of HEAD plus every uncommitted change;
# this hook recomputes the digest and refuses the push when they differ — no receipt, a receipt for
# an older tree, or an edit since the run. Installed by the script itself (`core.hooksPath`), so a
# clone that has never verified has never pushed either.
#
# `SKIP_VERIFY=1 git push` is the escape hatch for a deliberate exception (reverting a broken main,
# say). It is an environment variable rather than `--no-verify` so it has to be typed on purpose and
# shows in the shell history; the Claude hook refuses `--no-verify` outright.
set -euo pipefail

if [ "${SKIP_VERIFY:-}" = "1" ]; then
  echo "pre-push: SKIP_VERIFY=1 — pushing without the local pipeline run. The remote pipeline still runs." >&2
  exit 0
fi

git_dir="$(git rev-parse --absolute-git-dir)"
receipt="$git_dir/cvhome-verified"
current="$({ git rev-parse HEAD; git status --porcelain=v1 --untracked-files=all; git diff HEAD; } | shasum -a 256 | cut -d' ' -f1)"

if [ -f "$receipt" ] && [ "$(cat "$receipt")" = "$current" ]; then
  exit 0
fi

cat >&2 <<MSG
pre-push: refused — this tree has not passed the local pipeline run.

  $( [ -f "$receipt" ] && echo "The last receipt is for a different tree (something was committed or edited since)." || echo "No receipt exists for this clone yet." )

Run the whole pipeline locally first, then push:

  extra/scripts/verify-before-push.sh

It runs checkstyle, the build, unit and integration tests, the coverage floors, and both frontends'
lint and tests — the same checks the pipeline runs, so a green run here is a green pipeline there.
MSG
exit 1
