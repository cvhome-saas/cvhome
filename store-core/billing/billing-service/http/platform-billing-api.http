  "from": null,
  "to": null
}

> {%
    client.test("narrowed to one store", function () {
        client.assert(response.status === 200, "status " + response.status);
        (response.body.content || []).forEach(r => {
            client.assert(r.store === "{{STORE_ID}}", "leaked another store's history");
        });
    });
%}

### an org admin must not read the platform's billing
POST {{SELLER_UI_URL}}/billing/api/v1/platform/subscriptions?page=0&count=20
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{ORG_ADMIN_SESSION_ID}}
Content-Type: application/json

{
  "blockedOnly": false
}

> {%
    client.test("403 for a merchant", function () {
        client.assert(response.status === 403, "status " + response.status);
    });
%}

### and a super admin CAN now read one store's own subscription — the widening this change made
#
# hasAccessOnBillingRead gained `isSuperAdmin(a) ||`. Before it, a platform operator was refused for
# every store on the platform, and "this merchant says they paid" could only be answered from psql.
GET {{SELLER_UI_URL}}/billing/api/v1/subscription/current?store={{STORE_ID}}
Cookie: STORE-CORE-GATEWAY-JSESSIONID={{SESSION_ID}}

> {%
    client.test("a store the operator does not own is readable", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status, "no subscription status");
    });
%}
