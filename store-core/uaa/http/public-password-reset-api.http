# PublicPasswordResetController — where a password-reset link lands. Same contract as the invitation endpoints:
# anonymous, stateless, rate limited, the token is the credential, every refusal is the same 404.
# Take the token from the `link` an admin-issued reset answered with (admin-user-api.http → password-reset-links).

### preview — 200 LinkPreview {kind: PASSWORD_RESET, username, ...}
GET {{UAA_URL}}/api/v1/public/password-resets/{{UAA_ONE_TIME_TOKEN}}
Accept: application/json

### accept — 200 {username, loginUrl}; sets the password, ends every session and token of the account
POST {{UAA_URL}}/api/v1/public/password-resets/{{UAA_ONE_TIME_TOKEN}}/accept
Content-Type: application/json

{"password": "Reset-Passw0rd-2026"}

### the same token again — 404 UAA.PASSWORD.RESET_TOKEN_NOT_USABLE
POST {{UAA_URL}}/api/v1/public/password-resets/{{UAA_ONE_TIME_TOKEN}}/accept
Content-Type: application/json

{"password": "Reset-Passw0rd-2026"}

> {%
    client.test("spent", function () {
        client.assert(response.status === 404, "status " + response.status);
    });
%}
