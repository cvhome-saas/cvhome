{
  "name": "console-ui",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build",
    "dev": "ng serve",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:missing": "transloco-keys-manager find-missing",
    "lint": "eslint . && npm run lint:lessons && npm run lint:i18n",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:i18n": "node scripts/i18n-unused.mjs",
    "lint:lessons": "node scripts/check-lessons-citations.mjs",
    "ng": "ng",
    "serve:ssr:console-ui": "node dist/console-ui/server/server.mjs",
    "start": "ng serve",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "watch": "ng build --watch --configuration development"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.28",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-locale": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@jsverse/transloco-persist-lang": "^8.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "echarts": "^6.1.0",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "modern-screenshot": "^4.7.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.28",
    "@angular/cli": "^20.3.28",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.39.5",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0"
  }
}
